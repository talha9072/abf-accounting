# ABF New Companies — settings. Copy this file to `.env` on the server and fill in the empty
# values. Full notes: docs/HANDOVER.md, section 6. Never commit or share the filled-in file.

# ─── Database (PostgreSQL 14+) ─────────────────────────────────────
# postgresql://<user>:<password>@<host>:5432/<database>
DATABASE_URL=
# true for a hosted / remote database, false only for a database on the same machine
DATABASE_SSL=true

# ─── App ───────────────────────────────────────────────────────────
# Public https address of the app (used in password-reset links), e.g. https://newcompanies.example.com
APP_URL=

# ─── Companies House ───────────────────────────────────────────────
# The API key is NOT set here: an admin pastes it in the app (Business settings → Companies
# House), where it is checked and stored encrypted with AUTH_ENCRYPTION_KEY.

# Daily pull at 06:00 South Africa time (Africa/Johannesburg).
#   internal → the app schedules it itself (long-running Node server, e.g. PM2)
#   external → you run `npm run pull` from cron, or call /api/cron/pull with CRON_SECRET
#   off      → no automatic pulls
PULL_SCHEDULER=internal
# Only for PULL_SCHEDULER=external: a long random string (32+ characters).
#   Authorization: Bearer <CRON_SECRET>
CRON_SECRET=
# Testing only — import just the first N companies per pull. Leave empty on live.
PULL_LIMIT=

# History is kept for 12 months, then deleted after the morning pull (the Excluded /
# do-not-contact list is always kept). 0 = keep everything.
HISTORY_RETENTION_MONTHS=12
# Optional tuning
# ALLOWED_COMPANY_TYPES=ltd,llp,private-limited-guarant-nsc,private-limited-guarant-nsc-limited-exemption   (CICs are always skipped)
# SHARED_ADDRESS_THRESHOLD=5

# ─── Email (SMTP) ─────────────────────────────────────────────────
# Password-reset links and "morning pull failed" alerts. Letters are never emailed.
#   Microsoft 365: smtp.office365.com 587 · Google Workspace: smtp.gmail.com 587 (app password)
#   or your host's mailbox / Postmark / Brevo / SES SMTP. 465 = TLS, 587 = STARTTLS.
# Empty SMTP_HOST = no emails are sent (the rest of the app still works).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# e.g. "ABF New Companies <no-reply@abfaccounting.com>"
MAIL_FROM=

# ─── Encryption key ────────────────────────────────────────────────
# Required. Encrypts the Companies House key and authenticator-app secrets. Generate once:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep it secret and never change it (the Companies House key would have to be entered again).
AUTH_ENCRYPTION_KEY=

# ─── Registration ──────────────────────────────────────────────────
# Only these email domains may create an account (comma separated).
ALLOWED_SIGNUP_DOMAINS=abfaccounting.com
# Set to false once your team has accounts.
REGISTRATION_ENABLED=true
