# ─── Database (PostgreSQL) ─────────────────────────────────────────
# Local:  postgresql://<user>:<password>@localhost:5432/abf_accounting
# Live:   use the connection string from your host and set DATABASE_SSL=true
DATABASE_URL=postgresql://abf_app:change-me@localhost:5432/abf_accounting
DATABASE_SSL=false

# ─── App ───────────────────────────────────────────────────────────
# Public base URL — used to build password-reset links.
APP_URL=http://localhost:3000

# ─── Companies House (read-only REST key) ──────────────────────────
# developer.company-information.service.gov.uk → application (Live) → REST key
COMPANIES_HOUSE_API_KEY=

# Daily pull at 06:00 South Africa time (Africa/Johannesburg).
#   internal → the Next.js server schedules it itself (long-running Node server)
#   external → you run `npm run pull` from cron, or call /api/cron/pull with CRON_SECRET
#   off      → no automatic pulls
PULL_SCHEDULER=internal
# Long random string (32+ chars) for /api/cron/pull — Authorization: Bearer <secret>
CRON_SECRET=
# Testing only — import just the first N companies per pull (~N+2 API calls). Leave empty on live.
PULL_LIMIT=
# Optional tuning
# ALLOWED_COMPANY_TYPES=ltd,llp
# SHARED_ADDRESS_THRESHOLD=5

# ─── Registration ──────────────────────────────────────────────────
# Internal tool: only these email domains may create an account (comma separated).
ALLOWED_SIGNUP_DOMAINS=abfaccounting.com
# Set to false once your team has accounts.
REGISTRATION_ENABLED=true
